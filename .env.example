SHOPIFY_STORE_DOMAIN=your-shop-name
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your_storefront_public_token
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_storefront_private_token

# Custom app (dev.shopify.com) installed on the store — client ID + secret
# are exchanged for a short-lived Admin API token via the client credentials
# grant (see server/utils/shopifyAdmin.ts). The secret also verifies webhook
# HMAC signatures.
SHOPIFY_ADMIN_CLIENT_ID=your_custom_app_client_id
SHOPIFY_WEBHOOK_SECRET=your_custom_app_api_secret_key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
